# Salut! serveri — haqiqiy qiymatlarni faqat serverda saqlang, repoga yozmang.
# ── Yangi Google Cloud AI runtime gate (Task 1; provider transport hozircha ataylab disabled) ──
# Faqat project console'da model/API/location/permission tekshirilgach va ADC serverda sozlangach o'zgartiring.
VIVI_AI_ENABLED=false
VIVI_AI_PROVIDER=google-agent-platform
VIVI_AI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
GOOGLE_CLOUD_ADC_CONFIGURED=false
VIVI_AI_PROJECT_CONFIG_VERIFIED=false
VIVI_AI_KILL_SWITCH=on
VIVI_AI_LIVE_ENABLED=false
# Musbat limitlar va spend cap egasi tanlamaguncha bo'sh qoladi: bo'sh qiymat provider'ni o'chiradi.
VIVI_AI_MAX_REQUESTS_PER_DAY=
VIVI_AI_MAX_TOKENS_PER_DAY=
VIVI_AI_MAX_STT_AUDIO_SECONDS_PER_DAY=
VIVI_AI_MAX_TTS_CHARACTERS_PER_DAY=
VIVI_AI_MAX_SPEND_USD_PER_DAY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Asosiy model vaqtincha ishlamasa (5xx):
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Tabiiy ovoz (ElevenLabs).
#   eleven_v4 — o'zbek tilini qo'llaydi va [laughs] kabi hissiyot teglarini tushunadi (tavsiya).
#   eleven_v3 — o'zbek tilini QO'LLAMAYDI (ElevenLabs "unsupported_language" qaytaradi).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4
# Ixtiyoriy: tilni majburlash (masalan uz). Bo'sh — model o'zi aniqlaydi (fransuzcha qismlar uchun yaxshiroq).
ELEVENLABS_LANGUAGE_CODE=
#
# Ovozlar (birinchisi — standart). Ona tili o'zbek bo'lgan kutubxona ovozlari — pullik tarif (Starter+) kerak.
# Tezlik uchun ovozlarni ElevenLabs'da "My Voices"ga qo'shing (qo'shilgan ovoz ~0,8 s, qo'shilmagani ~3,6 s da boshlanadi).
ELEVENLABS_VOICES=Vivi (Dilzoda):dQR1p9Ft6NUixxE7xn1l,Mirzaev:RaNVfTYq3HYeFPLng6XN,Sodiqjon:CBeZJ4EnTnrJmhtlMCNC,Professor (Mirjalol):cfWx14ZbaEUT4BjIA5tH
# BEPUL tarifda kutubxona ovozlari API orqali ishlamaydi (402) — o'rniga standart ovozlar:
# ELEVENLABS_VOICES=Vivi:TX3LPaxmHKxFdv7VOQHJ,Hazilkash:N2lVS1w4EtoT3dr4eOWO,Mehribon:cgSgspJ2msm6clMCkdW9,Professor:pqHfZKP75CvOlQylNhV4

VOICE_SESSION_MINUTES=10
VOICE_COOLDOWN_MINUTES=20
TTS_CHARS_PER_DAY=12000
PORT=8787
VOICE_SESSION_MINUTES_SUPER=30
# Hedging: birinchi so'z shuncha ms ichida kelmasa, parallel ikkinchi so'rov yuboriladi (0 — o'chirish).
GEMINI_HEDGE_MS=1500
# Nutqni aniqlash modeli (o'zbekcha+fransuzcha uchun aniqroq)
GEMINI_STT_MODEL=gemini-3.5-flash

# ── Hisoblar ──
# Sessiya cookie imzosi uchun uzun tasodifiy satr (bo'sh bo'lsa data/ ichida avtomatik yaratiladi).
SESSION_SECRET=
# Ma'lumotlar bazasi (SQLite) papkasi. Serverda doimiy diskka qarating.
SALUT_DATA_DIR=data
# Google bilan kirish: Google Cloud Console → Credentials → OAuth client ID (Web). Android uchun ham shu Web ID.
# Bir nechta bo'lsa vergul bilan.
GOOGLE_CLIENT_ID=
# Ilovaning ochiq manzili (to'lovdan qaytish havolalari va xavfsiz cookie uchun), masalan https://salut.uz
PUBLIC_ORIGIN=
# Reverse proxy (nginx, Cloudflare, Railway...) ortida bo'lsa: 1
TRUST_PROXY=

# ── Super obunasi ──
PRICE_UZS_MONTH=49000
PRICE_UZS_YEAR=399000
# Payme Business → kassa. Endpoint: {PUBLIC_ORIGIN}/api/billing/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# 1 — test kassa (checkout.test.paycom.uz)
PAYME_TEST=
# Click Merchant. Prepare: {PUBLIC_ORIGIN}/api/billing/click/prepare  Complete: {PUBLIC_ORIGIN}/api/billing/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ── Bepul rejim (xarajatni nolga yaqinlashtirish) ──
# Limit (429) tugaganda navbatdagi Gemini modellari — har birining kunlik bepul limiti alohida.
GEMINI_ROTATION=gemini-flash-lite-latest,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-flash-latest
# Bepul foydalanuvchilar: kunlik AI xabarlar va ovozli suhbat daqiqalari (Super — cheksiz).
FREE_MESSAGES_PER_DAY=30
FREE_VOICE_MINUTES=5
# Bepul foydalanuvchilar ovozi: Gemini TTS (Super — ElevenLabs/Dilzoda).
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Leda
# Zaxira AI (ixtiyoriy, OpenAI bilan mos): Groq / OpenRouter / Cerebras / Mistral.
# Masalan Groq: FALLBACK_LLM_URL=https://api.groq.com/openai/v1  FALLBACK_LLM_MODEL=<model nomi>
FALLBACK_LLM_URL=
FALLBACK_LLM_KEY=
FALLBACK_LLM_MODEL=

# ── Bepul foydalanuvchilar uchun tiniq ovoz zaxiralari ──
# Gemini TTS limiti tugasa: Microsoft Azure (bepul F0 tarif: oyiga 500 000 belgi), so'ng ElevenLabs.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE=uz-UZ-MadinaNeural
AZURE_VOICE_FR=fr-FR-DeniseNeural
# ElevenLabs zaxirasi bepul foydalanuvchilar uchun kunlik umumiy belgi chegarasi (0 — o'chirish uchun FREE_TTS_ELEVENLABS=0).
FREE_ELEVENLABS_CHARS_PER_DAY=20000

# ── Ijtimoiy kirish (ixtiyoriy; bo'sh qolsa tugma ko'rinmaydi) ──
# Facebook: developers.facebook.com → App → Facebook Login (Web), domen va Valid OAuth Redirect.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Apple: developer.apple.com → Identifiers → Services ID (Sign in with Apple), Return URL = sayt manzili.
APPLE_CLIENT_ID=
# Telegram: @BotFather → yangi bot → /setdomain (sayt domeni). Mini App'da avtomatik kirish ham ishlaydi.
# Telegram: kirish + to'lov boti (tariflar, karta, chek, admin ✅/❌). Token — @BotFather'dan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Gemini Live (jonli rejim) ──
GEMINI_LIVE_MODEL=gemini-3.8-live
# LIVE_DISABLED=1 — jonli rejimni o'chirish

# Ilova egasi / sinovchilar: obunasiz Super (vergul bilan)
ADMIN_EMAILS=

# ── Super narxlari (so'm) ──
PLANS_VISIBLE=week,month,quarter
PRICE_UZS_WEEK=19000
PRICE_OLD_WEEK=29000
PRICE_UZS_MONTH=49000
PRICE_OLD_MONTH=79000
PRICE_UZS_QUARTER=119000
PRICE_OLD_QUARTER=237000
# Taqqoslash satri: «Repetitor bilan bir oy: ~~400 000 so'm~~ — bizda atigi ...»
ANCHOR_LABEL=Repetitor bilan bir oy
ANCHOR_UZS=400000
# Karta orqali to'lov (chek yuklanadi, admin tasdiqlaydi — /#/admin)
PAY_CARD_NUMBER=
PAY_CARD_OWNER=
PAY_CARD_BANK=
# Cheklar keladigan chat(lar) — ixtiyoriy: ADMIN_EMAILS hisobi botga bog'lansa, cheklar avtomatik keladi.
# O'z ID'ingizni bilish: botga /id yozing.
ADMIN_TELEGRAM_CHAT_ID=
# Jonli rejim: bepul daqiqalar (kuniga)
FREE_LIVE_MINUTES=10
